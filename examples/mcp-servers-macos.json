{
  "mcpServers": {
    "bixia-mcp": {
      "command": "/absolute/path/to/python3",
      "args": [
        "/Users/YOUR_NAME/Applications/bixia-mcp/scripts/bixia_client.py",
        "--config",
        "/Users/YOUR_NAME/.academic-rewrite/config.json"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    }
  }
}
