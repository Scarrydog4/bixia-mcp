      "args": [
        "${PLUGIN_ROOT}/scripts/bixia_client.py"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    }
  },
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json"
}
